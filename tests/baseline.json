      "year": 2026,
      "input": { "monthlySalary": 2600000, "weekHours": 40, "unusedDays": 5 },
      "expect": { "hourlyOrdinary": 12440, "dailyOrdinary": 99522, "total": 497608 },
      "note": "2,600,000 ÷ 209 = 12,440 / ×8h = 99,522 / ×5일 = 497,608"
    },
    {
