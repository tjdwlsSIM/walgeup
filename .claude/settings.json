{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "무인 실행(scripts/run-*.bat 의 claude -p)용 공유 권한. headless 모드는 권한을 물어볼 수 없어, allow 에 없는 툴은 조용히 거부되고 '성공했는데 아무것도 안 한' 실행이 된다. 개인 로컬 설정은 .claude/settings.local.json (git 제외).",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "WebSearch",
      "Task",
      "Agent",
      "WebFetch(domain:moel.go.kr)",
      "WebFetch(domain:www.moel.go.kr)",
      "WebFetch(domain:law.go.kr)",
      "WebFetch(domain:www.law.go.kr)",
      "WebFetch(domain:minimumwage.go.kr)",
      "WebFetch(domain:www.minimumwage.go.kr)",
      "WebFetch(domain:ei.go.kr)",
      "WebFetch(domain:www.ei.go.kr)",
      "WebFetch(domain:nps.or.kr)",
      "WebFetch(domain:www.nps.or.kr)",
      "WebFetch(domain:nhis.or.kr)",
      "WebFetch(domain:www.nhis.or.kr)",
      "WebFetch(domain:kcomwel.or.kr)",
      "WebFetch(domain:www.kcomwel.or.kr)",
      "WebFetch(domain:nts.go.kr)",
      "WebFetch(domain:www.nts.go.kr)",
      "WebFetch(domain:hometax.go.kr)",
      "WebFetch(domain:www.hometax.go.kr)",
      "WebFetch(domain:mohw.go.kr)",
      "WebFetch(domain:www.mohw.go.kr)",
      "WebFetch(domain:korea.kr)",
      "WebFetch(domain:www.korea.kr)",
      "WebFetch(domain:moleg.go.kr)",
      "WebFetch(domain:www.moleg.go.kr)",
      "WebFetch(domain:kostat.go.kr)",
      "WebFetch(domain:www.kostat.go.kr)",
      "WebFetch(domain:easylaw.go.kr)",
      "WebFetch(domain:www.easylaw.go.kr)",
      "WebFetch(domain:minwon.moel.go.kr)",
      "WebFetch(domain:comwel.or.kr)",
      "WebFetch(domain:www.comwel.or.kr)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(mkdir:*)",
      "Bash(test:*)",
      "Bash(for:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(npm publish:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
